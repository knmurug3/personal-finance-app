datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model BankItem {
  id              String    @id @default(cuid())
  accessToken     String
  itemId          String    @unique
  institutionName String
  status          String    @default("active")
  /// Last investments sync outcome: synced | pending | needs_consent | not_supported (null = no investment accounts)
  investmentsStatus String?
  /// Plaid /transactions/sync cursor: where the last incremental sync left off (null = full history next time)
  transactionsCursor String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]
}

model Account {
  id               String        @id @default(cuid())
  bankItemId       String
  bankItem         BankItem      @relation(fields: [bankItemId], references: [id], onDelete: Cascade)
  plaidAccountId   String        @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?
  currentBalance   Float
  availableBalance Float?
  isoCurrencyCode  String        @default("USD")
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
  holdings         Holding[]
  investmentTxs    InvestmentTransaction[]

  @@index([bankItemId])
}

model Transaction {
  id                 String             @id @default(cuid())
  accountId          String
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTransactionId String?            @unique
  amount             Float
  date               DateTime
  name               String
  merchantName       String?
  category           String
  tags               String[]           @default([])
  pending            Boolean            @default(false)
  reviewed           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  splits             TransactionSplit[]

  @@index([date])
  @@index([category])
  @@index([accountId])
  @@index([reviewed])
  @@index([accountId, date])
  @@index([date, category])
  @@index([plaidTransactionId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ip])
  @@index([ip, resetAt])
}

model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      String
  amount        Float
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model Budget {
  id           String   @id @default(cuid())
  category     String   @unique
  emoji        String   @default("📦")
  monthlyLimit Float
  /// Carry unspent (or overspent) amounts into following months
  rollover      Boolean   @default(false)
  /// First month (UTC month start) included in the rollover balance
  rolloverSince DateTime?
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id           String   @id @default(cuid())
  name         String
  merchantName String?
  amount       Float
  frequency    String   @default("monthly")
  nextDueDate  DateTime
  category     String   @default("Entertainment")
  status       String   @default("active")
  /// "detected" (auto, may be pruned) or "manual" (user-added, never touched by detection)
  source       String   @default("manual")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model CategoryRule {
  id              String   @id @default(cuid())
  merchantPattern String   @unique
  category        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  date             DateTime @unique
  netWorth         Float
  totalAssets      Float
  totalCash        Float
  totalInvestments Float
  totalDebt        Float
  createdAt        DateTime @default(now())

  @@index([date])
}

model Goal {
  id            String   @id @default(cuid())
  name          String
  emoji         String   @default("🎯")
  targetAmount  Float
  currentAmount Float    @default(0)
  targetDate    DateTime?
  category      String?  @default("Savings")
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ManualAccount {
  id        String   @id @default(cuid())
  name      String
  emoji     String   @default("💰")
  type      String   // "asset" or "liability"
  balance   Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  p256dh       String
  auth         String
  createdAt    DateTime @default(now())
}

// WebAuthn passkeys (Face ID / Touch ID / security keys) for the owner login
model Passkey {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]  @default([])
  name         String    @default("Passkey")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

// ── Investments (Plaid Investments product) ──────────────────────────────

model Security {
  id              String                  @id @default(cuid())
  plaidSecurityId String                  @unique
  ticker          String?
  name            String?
  type            String?                 // equity, etf, mutual fund, cash, cryptocurrency, …
  isCashEquivalent Boolean                @default(false)
  closePrice      Float?
  closePriceAsOf  DateTime?
  updatedAt       DateTime                @updatedAt
  holdings        Holding[]
  transactions    InvestmentTransaction[]

  @@index([ticker])
}

model Holding {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId       String
  security         Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  quantity         Float
  costBasis        Float?
  institutionPrice Float
  institutionValue Float
  priceAsOf        DateTime?
  updatedAt        DateTime @updatedAt

  @@unique([accountId, securityId])
  @@index([securityId])
}

model InvestmentTransaction {
  id                String    @id @default(cuid())
  plaidInvestmentId String    @unique
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId        String?
  security          Security? @relation(fields: [securityId], references: [id], onDelete: SetNull)
  date              DateTime
  name              String
  type              String    // buy, sell, cash, fee, transfer, cancel
  subtype           String
  quantity          Float
  price             Float
  amount            Float
  fees              Float?

  @@index([accountId, date])
  @@index([securityId])
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  date       DateTime @unique
  totalValue Float
  totalCost  Float
  createdAt  DateTime @default(now())
}

// Daily question counter for the Ask assistant (cost guard; owner and demo counted separately)
model ChatUsage {
  id    String @id // "<YYYY-MM-DD>:<owner|demo|demo-ip:<ip>>"
  count Int    @default(0)
}

// Small key/value store for background job bookkeeping (e.g. last recurring-bill detection)
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Grouped server/browser errors for the owner's error alerts and Health card
model ErrorEvent {
  id            String    @id @default(cuid())
  fingerprint   String    @unique
  source        String
  message       String
  path          String?
  count         Int       @default(1)
  firstSeen     DateTime  @default(now())
  lastSeen      DateTime  @updatedAt
  lastAlertedAt DateTime?

  @@index([lastSeen])
}
