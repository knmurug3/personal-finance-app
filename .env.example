# Required
SESSION_SECRET=            # 16+ random chars; signs session cookies
AUTH_USERNAME=
AUTH_PASSWORD=             # changing this signs everyone out
POSTGRES_PRISMA_URL=       # pooled connection string (serverless)
POSTGRES_URL_NON_POOLING=

ENCRYPTION_KEY=            # 64 hex chars (openssl rand -hex 32); encrypts stored Plaid tokens

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox          # sandbox | production
PLAID_WEBHOOK_URL=         # https://<your-domain>/api/plaid/webhook (real-time updates)

# Scheduled sync (Vercel sends this as a Bearer token to /api/cron/sync)
CRON_SECRET=               # openssl rand -hex 32

# Recommended
APP_TIMEZONE=              # e.g. America/New_York (default UTC)
WEBAUTHN_RP_ID=            # passkey domain, e.g. your-app.vercel.app
WEBAUTHN_ORIGIN=           # e.g. https://your-app.vercel.app

# Optional
ANTHROPIC_API_KEY=         # enables Ask
ASK_MODEL=                 # default claude-sonnet-5-5
FINNHUB_API_KEY=           # live stock quotes
FORECAST_LOW_BALANCE=      # default 500
TRANSFER_NAME_PATTERNS=    # comma-separated name fragments treated as transfers, e.g. "savings transfer,brokerage"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=             # e.g. mailto:you@example.com
